{
  "manifest_version": 3,
  "name": "Bug Bounty Hunter",
  "version": "1.1.0",
  "description": "Security scanning extension for bug bounty hunters - detects leaked secrets, dangerous sinks, CORS flaws and sensitive endpoints",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Bug Bounty Hunter"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scan-engine.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
  }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
